Screen {
    layout: vertical;
    background: $surface;
}

Header {
    dock: top;
    height: 1;
    background: $primary-darken-2;
    color: $text;
}

Footer {
    dock: bottom;
    height: 1;
    background: $primary-darken-3;
}

#main-container {
    layout: horizontal;
    height: 1fr;
    padding: 0 1;
}

#left-panel {
    width: 38%;
    height: 100%;
    border: round $primary;
    padding: 0 1;
    margin-right: 1;
    layout: vertical;
}

#dir-nav-bar {
    layout: horizontal;
    height: 3;
    align: left middle;
    margin-bottom: 0;
}

#btn-dir-up {
    min-width: 14;
    height: 3;
    margin-right: 1;
}

#lbl-current-dir {
    color: $text-muted;
    text-overflow: ellipsis;
    height: 1;
}

#file-tree {
    height: 1fr;
    border: none;
    background: transparent;
}

#lbl-selected-file {
    height: auto;
    min-height: 2;
    padding-top: 1;
    border-top: solid $primary-darken-2;
    color: $text;
}

#right-panel {
    width: 62%;
    height: 100%;
    layout: vertical;
}

.panel-title {
    text-style: bold;
    color: $accent;
    margin-bottom: 0;
    border-bottom: solid $primary-darken-1;
}

#config-box {
    border: round $primary;
    padding: 0 1;
    margin-bottom: 0;
    height: auto;
}

.config-row {
    layout: horizontal;
    height: 3;
    align: left middle;
}

.row-label {
    width: 14;
    text-style: bold;
    color: $accent;
}

#quality-radios {
    layout: horizontal;
    height: auto;
    border: none;
}

#quality-radios RadioButton {
    margin-right: 1;
    height: 1;
}

#radio-language {
    layout: horizontal;
    height: auto;
    border: none;
}

#radio-language RadioButton {
    margin-right: 2;
    height: 1;
}

#track-box {
    height: 3;
    margin: 0;
}

#track-row {
    layout: horizontal;
    height: 3;
    align: left middle;
}

#lbl-track-info {
    margin-right: 1;
    color: $text-muted;
}

#btn-toggle-track {
    min-width: 14;
    height: 3;
}

#prompt-row {
    layout: horizontal;
    height: 3;
    align: left middle;
}

#input-prompt {
    height: 3;
    width: 1fr;
}

#action-bar {
    height: 3;
    margin: 1 0;
}

#btn-start {
    width: 100%;
    height: 3;
    background: $success;
    color: $text;
    text-style: bold;
}

#btn-start:hover {
    background: $success-lighten-1;
}

#btn-start:disabled {
    background: $surface-darken-2;
    color: $text-muted;
}

#progress-box {
    border: round $primary;
    padding: 0 1;
    margin-bottom: 0;
    height: 4;
}

#lbl-status {
    height: 1;
}

#progress-bar {
    height: 1;
}

#log-box {
    border: round $primary;
    padding: 0 1;
    height: 1fr;
    min-height: 3;
}

#log-transcript {
    height: 1fr;
    background: $surface-darken-1;
}
